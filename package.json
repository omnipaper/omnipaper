    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.165",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "lucide-react": "1.70.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "zod": "4.6.7"
