DATABASE_URL=postgresql://user:password@host:5432/dbname
AUTH_SECRET=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=any-random-string-min-16-chars
APP_URL=http://localhost:3000
EXTRA_TRUSTED_ORIGINS=http://localhost:5173

# Optional: send AI SDK traces to Langfuse. Tracing only runs when LANGFUSE_PUBLIC_KEY is set
# AND the image was built with `--build-arg WITH_TRACING=true` (the published image is not).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_URL=https://cloud.langfuse.com
